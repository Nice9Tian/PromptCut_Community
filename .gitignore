node_modules
dist
# Online build (vite build --mode online,C10a): copied to the hosted side /editor/ on deploy
dist-online
out
/data/
.DS_Store
*.log
AGY-TASK-*.md
desktop/.cache
desktop/src-tauri/runtime
__pycache__/
*.pyc
tsconfig.tsbuildinfo

# AI assistant: session history and the attachment working folder of each session (server/vite-plugin-chats.ts)
.pc-chats/
.pc-work/

# Local drafts (server/vite-plugin-projects.ts): one .proc file per draft
.pc-projects/

# Local environment variables: the address and token of the diagnostic report collector are in here (see tools/report-worker/)
# Listing only .env.local is not enough: a bare .env is a key file just like .env.production
.env
.env.*
!.env.example

# OAuth client JSON downloaded from the Google Cloud console: the file name holds the client ID, the file holds the client secret.
# It belongs outside the repository (its location on this machine is recorded in docs/local.md); these lines are the fallback in case someone drags it in.
client_secret_*.json
client_secret*.json

# wrangler's local cache
.wrangler/

# Rust build output. desktop/src-tauri/target has long been ignored, but the targets of the few small tools under tools/ were
# left out: tools/report-worker/target alone is one or two GB
tools/*/target/

# Temporary files of SKILL mode: the id of the previous task, the exclusive lock of .proc.
# Only list *.proc.lock, **do not list *.lock**: Cargo.lock has to go into the repository
.pc-last-*.txt
*.proc.lock
undefined.lock

# Release artifacts of the desktop app (installers and patches are hundreds of MB each, not committed to the repository)
desktop/release/

# Local constants of the diagnostic report inbox (tools/report-inbox-gui/): Worker address + ADMIN_KEY.
# ADMIN_KEY can read everyone's reports and must never go into the repository. To hand it over, send inbox.local.example.json
tools/report-inbox-gui/inbox.local.json
# Local diagnostics, Agent discussions, test replicas and acceptance check output
/work/
reply_to_users_goal.md

# Local notes: environment information that only concerns this machine (the "Local information stays out of the repository" section of docs/semantics/guide_files/constraints.md)
docs/local.md
# Local state log left in the main checkout after the multi-machine workflow was invalidated (the handover log was excerpted into docs/archive/handover-log-2026-09.md)
docs/auto_long_work/local.md

# Agent entry point built locally (see README "Entry point for coding agents"): every tool injects it unconditionally, so it is not committed
/AGENTS.md
/CLAUDE.md
# Short-form requirements for tools that cannot read the local rules (codex, agy, etc.), generated locally, not committed
/my_agent/
