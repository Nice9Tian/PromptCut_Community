# Auto detect text files and perform LF normalization
* text=auto

# Rust/tauri tools always write Cargo files back with LF; match them so the working tree does not show them as modified (M) after a package build
desktop/src-tauri/Cargo.toml text eol=lf
desktop/src-tauri/Cargo.lock text eol=lf
# tauri build regenerates these permission files every time, also with LF
desktop/src-tauri/permissions/autogenerated/*.toml text eol=lf
# Server config templates must be placed on Linux as they are, so pin LF
server/hosted/deploy/* text eol=lf
